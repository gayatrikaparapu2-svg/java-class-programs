public class ExceptionTypes {

    public static void main(String[] args) {

        // 1. ArrayIndexOutOfBoundsException
        try {
            int a[] = {10, 20, 30};
            System.out.println(a[5]);
        } catch (ArrayIndexOutOfBoundsException e) {
            System.out.println("1. ArrayIndexOutOfBoundsException");
        }

        // 2. StringIndexOutOfBoundsException
        try {
            String s = "Java";
            System.out.println(s.charAt(10));
        } catch (StringIndexOutOfBoundsException e) {
            System.out.println("2. StringIndexOutOfBoundsException");
        }

        // 3. NullPointerException
        try {
            String s = null;
            System.out.println(s.length());
        } catch (NullPointerException e) {
            System.out.println("3. NullPointerException");
        }

        // 4. NumberFormatException
        try {
            int n = Integer.parseInt("abc");
        } catch (NumberFormatException e) {
            System.out.println("4. NumberFormatException");
        }

        // 5. ClassCastException
        try {
            Object obj = Integer.valueOf(10);
            String s = (String) obj;
        } catch (ClassCastException e) {
            System.out.println("5. ClassCastException");
        }

        // 6. NegativeArraySizeException
        try {
            int a[] = new int[-5];
        } catch (NegativeArraySizeException e) {
            System.out.println("6. NegativeArraySizeException");
        }

        // 7. ArrayStoreException
        try {
            Object a[] = new String[2];
            a[0] = 10;
        } catch (ArrayStoreException e) {
            System.out.println("7. ArrayStoreException");
        }

        // 8. IllegalArgumentException
        try {
            Thread.sleep(-100);
        } catch (IllegalArgumentException e) {
            System.out.println("8. IllegalArgumentException");
        } catch (InterruptedException e) {
            System.out.println("InterruptedException");
        }

        // 9. IllegalStateException
        try {
            throw new IllegalStateException("Invalid state");
        } catch (IllegalStateException e) {
            System.out.println("9. IllegalStateException");
        }

        // 10. SecurityException
        try {
            throw new SecurityException("Access denied");
        } catch (SecurityException e) {
            System.out.println("10. SecurityException");
        }
    }
}
