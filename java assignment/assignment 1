// single inheritance
package singleinheritance; 
 
// Parent class 
class Animal { 
 
    // Parent class method 
    void eat() { 
        System.out.println("Animal eats"); 
    } 
} 
 
// Child class inherits Animal 
class Dog extends Animal { 
 
    // Child class method 
    void bark() { 
        System.out.println("Dog barks"); 
    } 
} 
 
// Main class 
public class Main { 
 
    public static void main(String[] args) { 
 
        // Creating object of Dog 
        Dog d = new Dog(); 
 
        // Calling inherited method 
        d.eat(); 
 
        // Calling Dog method 
        d.bark(); 
    } 
} 

//multilevel inheritance
package multilevelinheritance; 
 
// First parent class 
class Animal { 
 
    // Method of Animal 
    void eat() { 
        System.out.println("Animal eats"); 
    } 
} 
 
// Dog inherits Animal 
class Dog extends Animal { 
 
    // Method of Dog 
    void bark() { 
        System.out.println("Dog barks"); 
    } 
} 
 
// Puppy inherits Dog 
class Puppy extends Dog { 
 
    // Method of Puppy 
    void play() { 
        System.out.println("Puppy plays"); 
    } 
} 
 
// Main class 
public class Main { 
 
    public static void main(String[] args) { 
 
        // Creating object of Puppy 
        Puppy p = new Puppy(); 
 
        // Calling Animal method 
        p.eat(); 
 
        // Calling Dog method 
        p.bark(); 
 
        // Calling Puppy method 
        p.play(); 
    } 
}

//Hierarchical Inheritance
package hierarchicalinheritance; 
 
// Parent class 
class Animal { 
 
    // Common method 
    void eat() { 
        System.out.println("Animal eats"); 
    } 
} 
 
// First child class 
class Dog extends Animal { 
 
    // Dog method 
    void bark() { 
        System.out.println("Dog barks"); 
    } 
} 
 
// Second child class 
class Cat extends Animal { 
 
    // Cat method 
    void meow() { 
        System.out.println("Cat meows"); 
    } 
} 
 
// Main class 
public class Main { 
 
    public static void main(String[] args) { 
 
        // Creating Dog object 
        Dog d = new Dog(); 
 
        // Calling inherited method 
        d.eat(); 
 
        // Calling Dog method 
        d.bark(); 
 
        // Creating Cat object 
        Cat c = new Cat(); 
 
        // Calling inherited method 
        c.eat(); 
 
        // Calling Cat method 
        c.meow(); 
    } 
}

//multiple inheritance
package multipleinheritance; 
// First interface 
interface A { 
// Method declaration 
void show(); 
} 
// Second interface 
interface B { 
 
    // Method declaration 
    void display(); 
} 
 
// Class implements both interfaces 
class C implements A, B { 
 
    // Implementing A's method 
    public void show() { 
        System.out.println("This is A method"); 
    } 
 
    // Implementing B's method 
    public void display() { 
        System.out.println("This is B method"); 
    } 
} 
 
// Main class 
public class Main { 
 
    public static void main(String[] args) { 
 
        // Creating object of C 
        C obj = new C(); 
 
        // Calling A method 
        obj.show(); 
// Calling B method 
obj.display(); 
} 
} 

//hybrid inheritance
package inh; 
//Single Inheritance(Animal->Dog) 
class Animal1 { 
void eat() { 
System.out.println("Animal eats food"); 
} 
} 
class Dog1 extends Animal1 { 
void bark() { 
System.out.println("Dog barks"); 
} 
} 
//Multilevel Inheritance(Animal->Dog->Puppy) 
class Animal2 { 
void eat() { 
System.out.println("Animal eats food"); 
} 
} 
class Dog2 extends Animal2 { 
void bark() { 
System.out.println("Dog barks"); 
} 
} 
class Puppy2 extends Dog2 { 
void play() { 
System.out.println("Puppy plays"); 
} 
} 
 
 
//Hierarchial Inheritance(   Animal    ) 
//                         /    \ 
//                      Dog      Cat 
                      
class Animal3 { 
 
void eat() { 
   System.out.println("Animal eats food"); 
} 
} 
 
class Dog3 extends Animal3 { 
 
void bark() { 
   System.out.println("Dog barks"); 
